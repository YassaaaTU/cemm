{
	"name": "nuxt_tailwindv4_template",
	"type": "module",
	"version": "1.6.0",
	"private": true,
	"packageManager": "bun@1.3.11",
	"author": "YassaaaTU aka YasirJumaah",
	"license": "MIT",
	"engines": {
		"node": ">=23"
	},
	"scripts": {
		"dev": "nuxt dev",
		"build": "nuxt build",
		"generate": "nuxt generate",
		"clean": "rm -r .nuxt .output node_modules",
		"preinstall": "bunx only-allow bun",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc --noEmit",
		"typecheck:fix": "vue-tsc --noEmit --skipLibCheck",
		"analyze": "nuxt analyze",
		"analyze:bundle": "vite-bundle-analyzer .output/dist/client",
		"tauri": "tauri",
		"app": "tauri dev",
		"app:build": "tauri build",
		"cargo:clean": "cd src-tauri; cargo clean",
		"cargo:check": "cd src-tauri; cargo check",
		"cargo:fix": "cd src-tauri; cargo fix",
		"bump": "bunx bumpp --all --config bump.config.ts"
	},
	"dependencies": {
		"@tauri-apps/plugin-dialog": "2.7.0",
		"@tauri-apps/plugin-fs": "2.5.0",
		"@tauri-apps/plugin-opener": "2.5.3",
		"@tauri-apps/plugin-process": "2.3.1",
		"@tauri-apps/plugin-updater": "2.10.1",
		"baseline-browser-mapping": "^2.10.14",
		"caniuse-lite": "^1.0.30001785",
		"nuxt": "^4.4.2",
		"pino": "^10.3.1",
		"tauri-plugin-keyring-api": "^0.1.1",
		"virtua": "^0.49.0",
		"vue": "^3.5.32"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/line-md": "^1.2.16",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/ri": "^1.2.10",
		"@iconify-json/solar": "^1.2.5",
		"@nuxt/devtools": "3.2.4",
		"@nuxt/eslint": "1.15.2",
		"@nuxt/icon": "^2.2.1",
		"@nuxt/image": "^2.0.0",
		"@pinia/nuxt": "0.11.3",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "4.2.2",
		"@tauri-apps/api": "2.10.1",
		"@tauri-apps/cli": "2.10.1",
		"@typescript-eslint/eslint-plugin": "8.58.0",
		"@typescript-eslint/parser": "8.58.0",
		"@vueuse/nuxt": "^14.2.1",
		"bumpp": "^11.0.1",
		"bundle-analyzer": "^0.0.6",
		"daisyui": "5.5.19",
		"eslint": "^10.2.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-pino-logger": "^1.0.2",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"nuxt-svgo": "4.2.6",
		"pinia-plugin-persistedstate": "4.7.1",
		"tailwindcss": "4.2.2",
		"typescript": "^6.0.2",
		"vite-bundle-analyzer": "^1.3.6",
		"vite-plugin-eslint2": "5.1.0"
	}
}