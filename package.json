{
	"name": "cemm",
	"type": "module",
	"version": "2.0.0",
	"private": true,
	"packageManager": "bun@1.3.11",
	"author": "YassaaaTU aka YasirJumaah",
	"license": "MIT",
	"engines": {
		"node": "^22.19.0 || ^24.11.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "nuxt dev",
		"build": "nuxt build",
		"generate": "nuxt generate",
		"clean": "rm -r .nuxt .output node_modules",
		"preinstall": "bunx only-allow bun",
		"postinstall": "nuxt prepare",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "bun lint --fix",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"typecheck": "vue-tsc --noEmit",
		"typecheck:fix": "vue-tsc --noEmit --skipLibCheck",
		"analyze": "nuxt analyze",
		"analyze:bundle": "vite-bundle-analyzer .output/dist/client",
		"tauri": "tauri",
		"app": "tauri dev",
		"app:build": "tauri build",
		"cargo:clean": "cd src-tauri; cargo clean",
		"cargo:check": "cd src-tauri; cargo check",
		"cargo:fix": "cd src-tauri; cargo fix",
		"types:generate": "cd src-tauri && cargo test export_bindings",
		"bump": "bunx bumpp --all --config bump.config.ts"
	},
	"dependencies": {
		"@tauri-apps/plugin-process": "2.3.1",
		"@tauri-apps/plugin-updater": "2.10.1",
		"@vue/devtools-api": "^8.2.1",
		"nuxt": "^4.5.2",
		"pinia": "^4.0.3",
		"pino": "^10.3.1",
		"tauri-plugin-keyring-api": "^0.1.1",
		"virtua": "^0.50.1",
		"vue": "^3.5.41",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/line-md": "^1.2.16",
		"@iconify-json/mdi": "^1.2.3",
		"@nuxt/devtools": "3.4.1",
		"@nuxt/eslint": "1.17.0",
		"@nuxt/icon": "^2.5.0",
		"@pinia/nuxt": "1.0.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "4.3.3",
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/cli": "2.11.4",
		"@types/bun": "^1.4.0",
		"@typescript-eslint/eslint-plugin": "8.67.0",
		"@typescript-eslint/parser": "8.67.0",
		"@vueuse/nuxt": "^14.4.0",
		"baseline-browser-mapping": "^2.11.14",
		"bumpp": "^12.2.1",
		"caniuse-lite": "^1.0.30001809",
		"daisyui": "5.7.17",
		"eslint": "^10.8.1",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-pino-logger": "^1.0.2",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"pinia-plugin-persistedstate": "4.7.1",
		"tailwindcss": "4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vite-bundle-analyzer": "^1.3.9",
		"vite-plugin-eslint2": "5.3.0",
		"vue-tsc": "3.3.10"
	}
}
